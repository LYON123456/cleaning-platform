# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cleaning_platform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# ECPay (模擬用，不需真實金鑰)
ECPAY_MERCHANT_ID="2000132"
ECPAY_HASH_KEY="5294y06JbISpM5x9"
ECPAY_HASH_IV="v77hoKGq4kWxNNIS"
ECPAY_RETURN_URL="http://localhost:3000/api/ecpay/callback"
ECPAY_ORDER_RESULT_URL="http://localhost:3000/booking/confirm"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="潔淨家 CleanHome"

# Admin IP Whitelist（逗號分隔，留空則不限制）
ADMIN_IP_WHITELIST="127.0.0.1,::1"

# Web Push（PWA 推播通知，使用 web-push 套件產生）
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_MAILTO="mailto:admin@cleanhome.tw"

# Telegram Notifications（不設定則用 console.log 模擬）
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Node Environment
NODE_ENV="development"
